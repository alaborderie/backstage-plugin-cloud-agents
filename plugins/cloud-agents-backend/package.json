{
  "name": "@alaborderie/plugin-cloud-agents-backend",
  "version": "0.1.0",
  "description": "Backstage backend plugin that runs cloud coding agents as Kubernetes Jobs and streams their events.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaborderie/backstage-plugin-cloud-agents",
    "directory": "plugins/cloud-agents-backend"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "cloud-agents",
    "pluginPackages": [
      "@alaborderie/plugin-cloud-agents",
      "@alaborderie/plugin-cloud-agents-backend",
      "@alaborderie/plugin-cloud-agents-common"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start --config dev/app-config.yaml",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@alaborderie/plugin-cloud-agents-common": "workspace:^",
    "@backstage/backend-plugin-api": "^1.11.0",
    "@backstage/config": "^1.3.10",
    "@backstage/errors": "^1.3.2",
    "@kubernetes/client-node": "1.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^4.22.0",
    "express-promise-router": "^4.1.0",
    "knex": "^3.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "^0.18.1",
    "@backstage/backend-test-utils": "^1.11.8",
    "@backstage/cli": "^0.36.7",
    "@backstage/plugin-auth-backend": "^0.30.2",
    "@backstage/plugin-auth-backend-module-guest-provider": "^0.2.24",
    "@types/express": "^4.17.6",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "^12.0.0",
    "supertest": "^7.0.0"
  },
  "files": [
    "dist",
    "migrations",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts"
}
