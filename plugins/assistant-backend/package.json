{
  "name": "@alaborderie/plugin-assistant-backend",
  "version": "0.1.0",
  "description": "Backstage backend plugin for a streaming chat that answers from the catalog, TechDocs, GitHub, and cloud agents, and launches cloud agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaborderie/backstage-plugin-cloud-agents",
    "directory": "plugins/assistant-backend"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "assistant",
    "pluginPackages": [
      "@alaborderie/plugin-assistant",
      "@alaborderie/plugin-assistant-backend",
      "@alaborderie/plugin-assistant-common"
    ]
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@alaborderie/plugin-assistant-common": "workspace:^",
    "@alaborderie/plugin-cloud-agents-common": "workspace:^",
    "@anthropic-ai/sdk": "~1.3.0",
    "@backstage/backend-plugin-api": "^1.11.0",
    "@backstage/catalog-model": "^1.10.2",
    "@backstage/config": "^1.3.10",
    "@backstage/errors": "^1.3.2",
    "@backstage/integration": "^2.1.3",
    "@backstage/plugin-catalog-node": "^2.2.6",
    "express": "^4.22.0",
    "express-promise-router": "^4.1.0",
    "knex": "^3.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "^0.18.1",
    "@backstage/backend-test-utils": "^1.11.8",
    "@backstage/cli": "^0.36.7",
    "@types/express": "^4.17.6",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "^12.0.0",
    "supertest": "^7.0.0"
  },
  "files": [
    "dist",
    "migrations",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts"
}
