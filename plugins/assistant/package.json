{
  "name": "@alaborderie/plugin-assistant",
  "version": "0.1.0",
  "description": "Backstage frontend plugin for a streaming chat that answers from the catalog, TechDocs, GitHub, and cloud agents, and follows the agents it launches.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaborderie/backstage-plugin-cloud-agents",
    "directory": "plugins/assistant"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "assistant",
    "pluginPackages": [
      "@alaborderie/plugin-assistant",
      "@alaborderie/plugin-assistant-backend",
      "@alaborderie/plugin-assistant-common"
    ]
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@alaborderie/plugin-assistant-common": "workspace:^",
    "@alaborderie/plugin-cloud-agents-common": "workspace:^",
    "@backstage/core-plugin-api": "^1.12.11",
    "@backstage/errors": "^1.3.2",
    "@backstage/frontend-plugin-api": "^0.18.2",
    "@backstage/ui": "^0.19.0",
    "@remixicon/react": "~4.8.0",
    "react-markdown": "^8.0.0",
    "remark-gfm": "^3.0.1"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/frontend-test-utils": "^0.6.5",
    "@backstage/test-utils": "^1.7.23",
    "@testing-library/dom": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2"
  },
  "files": [
    "dist"
  ]
}
